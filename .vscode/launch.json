{
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Launch",
            "program": "${workspaceFolder}/build/bin/app",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build All"
        },
        {
          "name": "Debug",
          "type": "cppdbg",
          "request": "launch",
          "program": "${workspaceFolder}/kernel/kernel",
          "cwd": "${workspaceFolder}",
          "miDebuggerPath": "/usr/bin/gdb-multiarch",
          "miDebuggerServerAddress": "127.0.0.1:25000",
          "MIMode": "gdb",
          "stopAtEntry": true,
          "preLaunchTask": "fix_gdbinit",
          "setupCommands": [
              {
                  "description": "Enable pretty-printing for gdb",
                  "text": "-enable-pretty-printing",
                  "ignoreFailures": false
              }
          ]
      }
    ]
}